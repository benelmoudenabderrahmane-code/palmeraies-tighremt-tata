{
  "name": "My workflow 2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish",
        "options": {}
      },
      "id": "b3e9382a-013d-4ec0-bf1f-73a77091b242",
      "name": "Receive from AutoPublish",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -528,
        240
      ],
      "webhookId": "77047054-d6e8-4308-b409-8eb045ed04a4"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.platforms.includes('youtube') || $json.body.platforms.includes('youtube_shorts') }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.platforms.includes('tiktok') }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.platforms.includes('instagram') }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.platforms.includes('facebook_group') }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "allMatchingOutputs": true
        }
      },
      "id": "fb60d5b2-0d6d-448b-9fc6-30acd4a4a928",
      "name": "Route by Platform",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        -288,
        240
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.body.video_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "aap-dl-video",
      "name": "Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -144,
        0
      ]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Receive from AutoPublish').item.json.body.product_name.substring(0, 100) }}",
        "regionCode": "FR",
        "categoryId": "22",
        "options": {
          "description": "={{ $('Receive from AutoPublish').item.json.body.youtube_description || ($('Receive from AutoPublish').item.json.body.caption + '\\n\\n' + $('Receive from AutoPublish').item.json.body.affiliate_link) }}",
          "privacyStatus": "public",
          "tags": "={{ ($('Receive from AutoPublish').item.json.body.youtube_tags || []).join(',') }}"
        }
      },
      "id": "336f73a0-9c99-442f-8b49-5cd51524fd6b",
      "name": "Upload to YouTube",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        96,
        0
      ],
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "FW42dQRSyqAsHF6g",
          "name": "YouTube account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/content/init/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.TIKTOK_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json; charset=UTF-8"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"post_info\": {\n    \"title\": \"{{ $('Receive from AutoPublish').item.json.body.product_name }}\",\n    \"description\": \"{{ $('Receive from AutoPublish').item.json.body.caption }}\\n\\n{{ $('Receive from AutoPublish').item.json.body.affiliate_link }}\",\n    \"privacy_level\": \"PUBLIC_TO_EVERYONE\",\n    \"disable_duet\": false,\n    \"disable_comment\": false,\n    \"disable_stitch\": false\n  },\n  \"source_info\": {\n    \"source\": \"PULL_FROM_URL\",\n    \"video_url\": \"{{ $('Receive from AutoPublish').item.json.body.video_url }}\"\n  }\n}",
        "options": {}
      },
      "id": "cce71f93-deb8-4f04-9671-79699ac46642",
      "name": "Upload to TikTok",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $vars.META_INSTAGRAM_ACCOUNT_ID }}/media",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $('Receive from AutoPublish').item.json.body.image_url }}"
            },
            {
              "name": "caption",
              "value": "={{ $('Receive from AutoPublish').item.json.body.caption }}\n\n{{ $('Receive from AutoPublish').item.json.body.affiliate_link }}"
            },
            {
              "name": "access_token",
              "value": "={{ $vars.META_USER_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "2c2a55a7-9d38-49af-8081-cc172deef4da",
      "name": "Post to Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        0,
        368
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $vars.META_GROUP_ID }}/feed",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $('Receive from AutoPublish').item.json.body.caption }}\n\n{{ $('Receive from AutoPublish').item.json.body.affiliate_link }}"
            },
            {
              "name": "access_token",
              "value": "={{ $vars.META_USER_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "216f9753-e8f4-4bf3-9d39-17d8fa29c6ee",
      "name": "Post to Facebook Group",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        0,
        544
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Receive from AutoPublish').item.json.body.callback_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platform_url: $json.uploadId ? 'https://youtube.com/watch?v=' + $json.uploadId : 'published-by-n8n', platform_post_id: $json.uploadId || 'ok' }) }}",
        "options": {}
      },
      "id": "438e4cc3-9c56-4ec0-807c-e190cb39a5f7",
      "name": "Mark as Published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        272,
        272
      ]
    }
